import java.util.*;
class Node
{
	int data;
	Node next;
}
class MyStack
{
	Node top;
	MyStack()
	{
	    top=null;
	}
	void push(int ele)
	{
			Node cur=new Node();
			cur.data=ele;
			cur.next=top;
			top=cur;
        System.out.println(ele +"  data insert ");

	}
	void pop()
	{
	        if(top==null)
	        {
	            System.out.println("no element or underflow ");
	            return;
	        }
	      System.out.println("delete element ="+top.data);
	      top=top.next;

	}
	void peek()
	{
	        if(top==null)
	        {
	            System.out.println("no element or underflow ");
	            return;
	        }
	        System.out.println("top element ="+top.data);
	     
	}
	void disp()
	{
	     if(top==null)
	        {
	            System.out.println("no element or underflow ");
	            return;
	        }
	        Node ptr=top;
	        while(ptr!=null)
	        {
	            System.out.println(ptr.data);
	            ptr=ptr.next;
	        }
	}
}
class MyStackTest
{
	public static void main(String arg[])
	{
	      Scanner sc=new Scanner(System.in);
	      MyStack s=new MyStack();
         while(true)
         {
            System.out.println("enter your choice\n1.push\n2.pop\n3.peek\n4.disp\n5.exit");
            int ch=sc.nextInt();
            switch(ch)
            {
               case 1:System.out.println("enter element to push ");
                     s.push(sc.nextInt());
                     break;
               case 2:s.pop();break;
               case 3:s.peek();break;
               case 4:s.disp();break;
               case 5:System.exit(0);
               default :System.out.println("invalid choice ");
            }

         }
	}
}














































import java.util.*;
class Node
{
	int data;
	Node next;
}
class MyQueue
{
	Node front,rear;
	MyQueue()
	{
	    front=null;
	    rear=null;
	}
	void enqueue(int ele)
	{
			Node cur=new Node();
			cur.data=ele;
			cur.next=null;
			System.out.println(ele+ " insert ");
			if(front==null)
			{
				front=cur;
				rear=cur;
				return ;

			}
			rear.next=cur;
			rear=cur;
	}
	void dequeue()
	{
	        if(front==null)
	        {
	            System.out.println("no element or underflow ");
	            return;
	        }
	      System.out.println("delete element ="+front.data);
	      if(front==rear)
	      {
	      	 front=null;
	      	 rear=null;
	      	 return ;
	      }
	      front=front.next;

	}
	void peek()
	{
	        if(front==null)
	        {
	            System.out.println("no element or underflow ");
	            return;
	        }
	        System.out.println("top element ="+front.data);
	     
	}
	void disp()
	{
	     if(front==null)
	        {
	            System.out.println("no element or underflow ");
	            return;
	        }
	        Node ptr=front;
	        while(ptr!=null)
	        {
	            System.out.println(ptr.data);
	            ptr=ptr.next;
	        }
	}
}
class MyQueueTest
{
	public static void main(String arg[])
	{
	      Scanner sc=new Scanner(System.in);
	      MyQueue s=new MyQueue();
         while(true)
         {
            System.out.println("enter your choice\n1.insert\n2.delete\n3.peek\n4.disp\n5.exit");
            int ch=sc.nextInt();
            switch(ch)
            {
               case 1:System.out.println("enter element to push ");
                     s.enqueue(sc.nextInt());
                     break;
               case 2:s.dequeue();break;
               case 3:s.peek();break;
               case 4:s.disp();break;
               case 5:System.exit(0);
               default :System.out.println("invalid choice ");
            }

         }
	}
}